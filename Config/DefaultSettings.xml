<AutoTraderSettings>

  <!-- ============================================ -->
  <!-- ES (E-mini S&P 500 Futures) Settings -->
  <!-- ============================================ -->
  <InstrumentSettings name="ES" description="E-mini S&P 500 Futures">
    <Timeframe>5 Minutes</Timeframe>

    <TrendParameters>
      <FastEMAPeriod>8</FastEMAPeriod>
      <SlowEMAPeriod>21</SlowEMAPeriod>
      <TrendEMAPeriod>50</TrendEMAPeriod>
    </TrendParameters>

    <MomentumParameters>
      <RSIPeriod>14</RSIPeriod>
      <RSIUpperThreshold>70</RSIUpperThreshold>
      <RSILowerThreshold>30</RSILowerThreshold>
      <RSILongMin>40</RSILongMin>
      <RSIShortMax>60</RSIShortMax>
    </MomentumParameters>

    <VolatilityParameters>
      <ATRPeriod>14</ATRPeriod>
      <ATRMultiplierStop>2.0</ATRMultiplierStop>
      <ATRMultiplierTarget>4.0</ATRMultiplierTarget>
      <MinATRThreshold>1.0</MinATRThreshold>
    </VolatilityParameters>

    <VolumeParameters>
      <VolumeSMAPeriod>20</VolumeSMAPeriod>
      <VolumeMultiplier>1.3</VolumeMultiplier>
    </VolumeParameters>

    <RiskManagement>
      <RiskPercent>1.0</RiskPercent>
      <MaxDailyLossPercent>3.0</MaxDailyLossPercent>
      <MaxConsecutiveLosses>3</MaxConsecutiveLosses>
      <MaxTradesPerDay>5</MaxTradesPerDay>
    </RiskManagement>

    <TimeFilter>
      <EnableTimeFilter>true</EnableTimeFilter>
      <TradingStartTime>09:30</TradingStartTime>
      <TradingEndTime>15:30</TradingEndTime>
    </TimeFilter>

    <TrailingStop>
      <EnableTrailingStop>true</EnableTrailingStop>
      <TrailingStopActivationATR>1.0</TrailingStopActivationATR>
      <TrailingStopATR>1.5</TrailingStopATR>
    </TrailingStop>
  </InstrumentSettings>

